{
  "schemaVersion": 1,
  "id": "mega_client",
  "version": "${version}",
  "name": "M.E.G.A Client",
  "description": "Client-side ESP, tracers, X-ray, farm alerts and block counter. Needs only Fabric Loader. Info only, no automation.",
  "authors": [
    "MagicWinter"
  ],
  "environment": "client",
  "entrypoints": {
    "client": [
      "dev.mega.client.MegaClient"
    ],
    "fabric-client-gametest": [
      "dev.mega.client.MegaClientGameTest",
      "dev.mega.client.MegaScenarioTest",
      "dev.mega.client.MegaDigScenario"
    ]
  },
  "depends": {
    "fabricloader": ">=0.17.0",
    "minecraft": "~1.21.11",
    "java": ">=21"
  },
  "mixins": [
    "mega_client.mixins.json"
  ]
}