{
  "schemaVersion": 1,
  "id": "mega_client",
  "version": "${version}",
  "name": "M.E.G.A Client",
  "description": "Client-side HUD: player warning, nearby player list and loaded-chunk block radar. Info only, no automation.",
  "authors": [
    "MagicWinter"
  ],
  "environment": "client",
  "entrypoints": {
    "client": [
      "dev.mega.client.MegaClient"
    ],
    "fabric-client-gametest": [
      "dev.mega.client.MegaClientGameTest"
    ]
  },
  "depends": {
    "fabricloader": ">=0.17.0",
    "minecraft": "~1.21.11",
    "java": ">=21",
    "fabric-api": "*"
  },
  "mixins": [
    "mega_client.mixins.json"
  ]
}